root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# C# and WPF markup use the four-space indent this codebase already follows.
[*.cs]
indent_size = 4

[*.xaml]
indent_size = 4

[Makefile]
indent_style = tab
