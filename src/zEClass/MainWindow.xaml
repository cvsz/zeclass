<Window x:Class="zEClass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:zEClass"
        xmlns:core="clr-namespace:zEClass.Core;assembly=zEClass"
        Title="zEClass Interactive Whiteboard"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource BoardVoid}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        AutomationProperties.Name="zEClass Interactive Whiteboard">

  <Window.Resources>
    <Style TargetType="TextBlock" x:Key="ChromeLabel">
      <Setter Property="Foreground" Value="#FF9AA3B2" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource ChromePanel}" />
      <Setter Property="Foreground" Value="{StaticResource ChromeForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinWidth" Value="66" />
      <!--
        A Setter cannot carry a Binding, so the accessible name is not derived from Content
        here. Every button sets AutomationProperties.Name explicitly instead, which is more
        reliable for a screen reader than a runtime binding on a template setter.
      -->
    </Style>

    <Style TargetType="Button" x:Key="ToolButton" BasedOn="{StaticResource ChromeButton}">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="52" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF39404E" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChromeAccent}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      ToggleButton needs its own style: WPF will not apply a style whose TargetType is Button to
      a ToggleButton, and it fails at load time rather than falling back.
    -->
    <Style TargetType="ToggleButton" x:Key="ToolToggle">
      <Setter Property="Foreground" Value="{StaticResource ChromeForeground}" />
      <Setter Property="Background" Value="{StaticResource ChromePanel}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#FF39404E" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChromeAccent}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChromeAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToggleButton" x:Key="ChromeToggle">
      <Setter Property="Background" Value="{StaticResource ChromePanel}" />
      <Setter Property="Foreground" Value="{StaticResource ChromeForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinWidth" Value="66" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChromeAccent}" />
                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource ChromeAccent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox" x:Key="PaletteCombo">
      <Setter Property="Background" Value="{StaticResource ChromePanel}" />
      <Setter Property="Foreground" Value="{StaticResource ChromeForeground}" />
      <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Margin" Value="0,2,0,4" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource ChromeBackground}">
      <Grid Margin="12,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Column="0">
          <TextBlock Text="zEClass" Foreground="{StaticResource ChromeForeground}"
                     FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock x:Name="DocNameText" Text="Untitled board" Margin="14,0,0,0"
                     Foreground="{StaticResource ChromeForeground}" FontSize="14"
                     VerticalAlignment="Center" />
          <TextBlock Text="Powered by ZEAZDEV COMPANY LIMITED" Margin="14,0,0,0"
                     Foreground="{StaticResource ChromeForeground}" Opacity="0.65" FontSize="12"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Column="1" Text="Ready"
                   Foreground="{StaticResource ChromeForeground}" Opacity="0.85" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal" Grid.Column="2">
          <Button x:Name="NewBtn" Content="New" Style="{StaticResource ChromeButton}" Click="OnNewClick" />
          <Button x:Name="OpenBtn" Content="Open" Style="{StaticResource ChromeButton}" Click="OnOpenClick" />
          <Button x:Name="ImportBtn" Content="Import" Style="{StaticResource ChromeButton}"
                  Click="OnImportClick" ToolTip="Bring a PDF, slide deck or image onto the board" />
          <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource ChromeButton}" Click="OnSaveClick" />
          <Button x:Name="SaveAsBtn" Content="Save as" Style="{StaticResource ChromeButton}"
                  Click="OnSaveAsClick" />
          <ToggleButton x:Name="FullScreenBtn" Content="Full screen"
                        Style="{StaticResource ChromeToggle}" MinWidth="104"
                        Checked="OnFullScreenOn" Unchecked="OnFullScreenOff" />
        </StackPanel>
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource ChromeBackground}" Width="124">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,10">
          <Button x:Name="PenBtn" Style="{StaticResource ToolButton}" Content="Pen"
                  Click="OnToolClick" Tag="Pen"
                  AutomationProperties.HelpText="Pen. Shortcut B" />
          <Button x:Name="HighlighterBtn" Style="{StaticResource ToolButton}" Content="Mark"
                  Click="OnToolClick" Tag="Highlighter" ToolTip="Highlighter. Shortcut H" />
          <Button x:Name="EraserBtn" Style="{StaticResource ToolButton}" Content="Erase"
                  Click="OnToolClick" Tag="Eraser" ToolTip="Eraser. Shortcut E" />
          <Button x:Name="LineBtn" Style="{StaticResource ToolButton}" Content="Line"
                  Click="OnToolClick" Tag="Line" />
          <Button x:Name="RectBtn" Style="{StaticResource ToolButton}" Content="Rect"
                  Click="OnToolClick" Tag="Rectangle" />
          <Button x:Name="EllipseBtn" Style="{StaticResource ToolButton}" Content="Oval"
                  Click="OnToolClick" Tag="Ellipse" />
          <Button x:Name="TriangleBtn" Style="{StaticResource ToolButton}" Content="Tri"
                  Click="OnToolClick" Tag="Triangle" />
          <Button x:Name="ArrowBtn" Style="{StaticResource ToolButton}" Content="Arrow"
                  Click="OnToolClick" Tag="Arrow" />
          <Button x:Name="StarBtn" Style="{StaticResource ToolButton}" Content="Star"
                  Click="OnToolClick" Tag="Star" />
          <Button x:Name="TextBtn" Style="{StaticResource ToolButton}" Content="Text"
                  Click="OnToolClick" Tag="Text" ToolTip="Text. Shortcut T" />

          <Separator Margin="0,6" Background="{StaticResource ChromeBorder}" />
          <ToggleButton x:Name="PinchToggle" Content="Pinch" Style="{StaticResource ToolToggle}"
                        IsChecked="True" ToolTip="Two-finger zoom and pan are always active on touch" />
          <ToggleButton x:Name="RecognitionToggle" Content="Shapes" Style="{StaticResource ToolToggle}"
                        Checked="OnRecognitionPenChanged" Unchecked="OnRecognitionPenChanged"
                        ToolTip="Recognition pen: circle to spotlight, square to magnifier" />
          <Button x:Name="SelectBtn" Style="{StaticResource ToolButton}" Content="Select"
                  Click="OnToolClick" Tag="Select" />
          <Button x:Name="LassoBtn" Style="{StaticResource ToolButton}" Content="Lasso"
                  Click="OnToolClick" Tag="Lasso" />
          <Button x:Name="PanBtn" Style="{StaticResource ToolButton}" Content="Pan"
                  Click="OnToolClick" Tag="Pan" />

          <Separator Margin="0,6" Background="{StaticResource ChromeBorder}" />
          <Button x:Name="UndoBtn" Style="{StaticResource ToolButton}" Content="Undo"
                  Click="OnUndoClick" ToolTip="Undo. Ctrl+Z" />
          <Button x:Name="RedoBtn" Style="{StaticResource ToolButton}" Content="Redo"
                  Click="OnRedoClick" ToolTip="Redo. Ctrl+Y" />
          <Button x:Name="ClearBtn" Style="{StaticResource ToolButton}" Content="Clear"
                  Click="OnClearClick" />
          <Button x:Name="ImageBtn" Style="{StaticResource ToolButton}" Content="Image"
                  Click="OnInsertImageClick" />
          <Button x:Name="CalibrateBtn" Style="{StaticResource ToolButton}" Content="Align"
                  Click="OnCalibrateClick" ToolTip="Four-point board calibration" />

          <Separator Margin="0,6" Background="{StaticResource ChromeBorder}" />
          <TextBlock Text="Ink" Style="{StaticResource ChromeLabel}" Margin="4,0,0,2" />
          <ComboBox x:Name="ColorBox" Style="{StaticResource PaletteCombo}" Width="108"
                    SelectedIndex="0" Cursor="Hand"
                    AutomationProperties.Name="Ink colour" />
          <Slider x:Name="WidthSlider" Width="108" Minimum="1" Maximum="24" Value="4"
                  VerticalAlignment="Center" Margin="0,6,0,4" IsSnapToTickEnabled="True"
                  TickFrequency="1" ToolTip="Stroke width" ValueChanged="OnWidthChanged"
                  AutomationProperties.Name="Stroke width" />
          <TextBlock Text="Line" Style="{StaticResource ChromeLabel}" Margin="4,4,0,0" />
          <ComboBox x:Name="LineStyleBox" Style="{StaticResource PaletteCombo}" Width="108"
                    SelectedIndex="0" Cursor="Hand" SelectionChanged="OnLineStyleChanged"
                    AutomationProperties.Name="Line style" />
          <TextBlock Text="Fill" Style="{StaticResource ChromeLabel}" Margin="4,4,0,0" />
          <ComboBox x:Name="FillBox" Style="{StaticResource PaletteCombo}" Width="108"
                    SelectedIndex="0" Cursor="Hand" SelectionChanged="OnFillChanged"
                    AutomationProperties.Name="Shape fill" />

          <Separator Margin="0,6" Background="{StaticResource ChromeBorder}" />
          <TextBlock Text="Theme" Style="{StaticResource ChromeLabel}" Margin="4,0,0,2" />
          <ComboBox x:Name="ThemeBox" Style="{StaticResource PaletteCombo}" Width="108"
                    SelectedIndex="0" Cursor="Hand" SelectionChanged="OnThemeChanged"
                    AutomationProperties.Name="Board theme" />
          <TextBlock Text="Language" Style="{StaticResource ChromeLabel}" Margin="4,4,0,0" />
          <ComboBox x:Name="LanguageBox" Style="{StaticResource PaletteCombo}" Width="108"
                    SelectedIndex="0" Cursor="Hand" SelectionChanged="OnLanguageChanged"
                    AutomationProperties.Name="Interface language" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource BoardVoid}">
      <ui:InkSurface x:Name="Surface" />
      <ui:CalibrationOverlay x:Name="CalibrationLayer" Visibility="Collapsed" />
      
    </Grid>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource ChromeBackground}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="12,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Grid.Column="0">
            <Button x:Name="PrevPageBtn" Content="&#x25C0; Prev" Style="{StaticResource ChromeButton}"
                    MinWidth="86" Click="OnPrevPageClick" />
            <TextBlock x:Name="PageText" Text="Page 1 / 5" Margin="12,0" Foreground="{StaticResource ChromeForeground}"
                       VerticalAlignment="Center" FontSize="14" />
            <Button x:Name="NextPageBtn" Content="Next &#x25B6;" Style="{StaticResource ChromeButton}"
                    MinWidth="86" Click="OnNextPageClick" />
            <Button x:Name="AddPageBtn" Content="+ Page" Style="{StaticResource ChromeButton}"
                    MinWidth="76" Margin="8,0,0,0" Click="OnAddPageClick" />
            <Separator Margin="10,0" Background="{StaticResource ChromeBorder}" />
            <Button x:Name="ZoomOutBtn" Content="&#x2212;" Style="{StaticResource ChromeButton}"
                    MinWidth="32" Padding="0" Click="OnZoomOutClick" ToolTip="Zoom out" />
            <TextBlock x:Name="ZoomText" Text="100%" Margin="8,0" Foreground="{StaticResource ChromeBorder}"
                       VerticalAlignment="Center" FontSize="13" MinWidth="44" />
            <Button x:Name="ZoomInBtn" Content="+" Style="{StaticResource ChromeButton}"
                    MinWidth="32" Padding="0" Click="OnZoomInClick" ToolTip="Zoom in" />
            <Button x:Name="ZoomResetBtn" Content="Fit" Style="{StaticResource ChromeButton}"
                    MinWidth="52" Click="OnZoomResetClick" ToolTip="Reset the view" />
            <Separator Margin="10,0" Background="{StaticResource ChromeBorder}" />
            <Button x:Name="MagnifierBtn" Content="Zoom tool" Style="{StaticResource ChromeButton}"
                    MinWidth="86" Click="OnMagnifierClick" ToolTip="Live magnifier (F1)" />
            <Button x:Name="SpotlightBtn" Content="Spotlight" Style="{StaticResource ChromeButton}"
                    MinWidth="86" Click="OnSpotlightClick" ToolTip="Dim the screen except a circle" />
            <Button x:Name="CurtainBtn" Content="Curtain" Style="{StaticResource ChromeButton}"
                    MinWidth="78" Click="OnCurtainClick" ToolTip="Hide the board to conceal an answer (F3)" />
            <Button x:Name="ClockBtn" Content="Clock" Style="{StaticResource ChromeButton}"
                    MinWidth="66" Click="OnClockClick" ToolTip="Teaching clock (F4)" />
            <Button x:Name="KeyboardBtn" Content="Keys" Style="{StaticResource ChromeButton}"
                    MinWidth="58" Click="OnKeyboardClick" ToolTip="On-screen keyboard (F5)" />
            <Button x:Name="CaptureBtn" Content="Capture" Style="{StaticResource ChromeButton}"
                    MinWidth="80" Click="OnCaptureClick" ToolTip="Insert a screenshot of the desktop (F6)" />
            <Button x:Name="RecordBtn" Content="Record" Style="{StaticResource ChromeButton}"
                    MinWidth="76" Click="OnRecordClick"
                    ToolTip="Record the screen to an AVI" />
            <Button x:Name="AudioBtn" Content="Audio" Style="{StaticResource ChromeButton}"
                    MinWidth="76" Click="OnAudioClick"
                    ToolTip="Record classroom audio to a WAV file" />
            <Button x:Name="PlaybackBtn" Content="Play back" Style="{StaticResource ChromeButton}"
                    MinWidth="88" Click="OnPlaybackClick"
                    ToolTip="Replay this page's strokes in draw order" />
            <TextBlock x:Name="RecordStatus" Text="" Margin="8,0,0,0" MinWidth="180"
                       Foreground="{StaticResource ChromeBorder}" VerticalAlignment="Center"
                       FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Grid.Column="2">
            <Button x:Name="ExportBtn" Content="Export" Style="{StaticResource ChromeButton}"
                    Click="OnExportClick" />
            <Button x:Name="PrintBtn" Content="Print" Style="{StaticResource ChromeButton}"
                    Click="OnPrintClick" />
            <Button x:Name="EmailBtn" Content="Email" Style="{StaticResource ChromeButton}"
                    Margin="0,0,8,0" Click="OnEmailClick" ToolTip="Package the board and open a mail draft" />
            <Button x:Name="DiagBtn" Content="Diagnostics" Style="{StaticResource ChromeButton}"
                    MinWidth="106" Click="OnDiagClick" />
            <Button x:Name="ExportDiagBtn" Content="Save report" Style="{StaticResource ChromeButton}"
                    MinWidth="106" Margin="0" Click="OnExportDiagnosticsClick"
                    ToolTip="Write a diagnostics file for support" />
            <Button x:Name="AcceptanceBtn" Content="Acceptance test"
                    Style="{StaticResource ChromeButton}" MinWidth="132" Margin="8,0,0,0"
                    Click="OnAcceptanceClick"
                    ToolTip="Verify this panel's pressure, touch, palm rejection and calibration" />
            <Button x:Name="AboutBtn" Content="About" Style="{StaticResource ChromeButton}"
                    MinWidth="76" Margin="8,0,0,0" Click="OnAboutClick"
                    ToolTip="About zEClass and its developer" />
            <TextBlock x:Name="DigitizerText" Text="Digitizer: probing..." Margin="12,0,0,0"
                       Foreground="{StaticResource ChromeBorder}" VerticalAlignment="Center"
                       FontSize="13" />
          </StackPanel>
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled" Margin="8,0,8,6">
          <ItemsControl x:Name="PageStripHost" AutomationProperties.Name="Page thumbnails">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</Window>
