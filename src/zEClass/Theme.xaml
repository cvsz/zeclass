<?xml version="1.0" encoding="utf-8"?>
<!--
  Runtime-swappable palette. Values come from zEClass.Core.Theme via ThemeManager, which writes
  them into these keys at startup and whenever the theme changes. The literals here are the dark
  defaults, so the XAML also loads standalone in a designer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="ChromeBackground" Color="#FF20232A" />
  <SolidColorBrush x:Key="ChromeForeground" Color="#FFF2F4F8" />
  <SolidColorBrush x:Key="ChromeAccent" Color="#FF3D7EFF" />
  <SolidColorBrush x:Key="ChromePanel" Color="#FF2B2F38" />
  <SolidColorBrush x:Key="ChromeBorder" Color="#FF3A3F4B" />
  <SolidColorBrush x:Key="ChromeSubtleText" Color="#FF9AA3B2" />
  <SolidColorBrush x:Key="BoardVoid" Color="#FF15171C" />

</ResourceDictionary>
